# =============================================================================
# PyCharm
.idea/
*.iml
*.ipr
*.iws

# VS Code
.vscode/
.settings/
.project
.classpath

# Jupyter Notebook
.ipynb_checkpoints

# Spyder
.spyderproject
.spyproject

# =============================================================================
# TESTING & COVERAGE
# =============================================================================
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

